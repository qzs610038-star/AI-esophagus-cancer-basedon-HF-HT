# ============================================
# PFMval 项目 Git 属性配置
# 自动检测文本文件，并强制工作树使用 LF 换行。
# Gitee 远端不启用 Git LFS；二进制与大文件使用普通 Git Blob 或由 large_artifacts 仅记录元数据
# ============================================

# 自动检测文本文件，并强制工作树使用 LF 换行。
# This keeps state/document SHA-256 values stable on Windows servers.
* text=auto eol=lf

# --------------------------------------------
# 二进制大文件定义：禁用文本换行与 LFS filter
# --------------------------------------------
*.pth -text -diff -filter -merge
*.pt -text -diff -filter -merge
*.bin -text -diff -filter -merge
*.safetensors -text -diff -filter -merge

# --------------------------------------------
# 压缩包与归档文件
# --------------------------------------------
*.zip -text -diff -filter -merge
*.tar.gz -text -diff -filter -merge
*.tar -text -diff -filter -merge
*.rar -text -diff -filter -merge
*.7z -text -diff -filter -merge

# --------------------------------------------
# 大型数据文件
# --------------------------------------------
*.tiff -text -diff -filter -merge
*.tif -text -diff -filter -merge
*.h5 -text -diff -filter -merge
*.hdf5 -text -diff -filter -merge

# Result bundles contain server-produced byte-exact artifacts whose hashes are
# recorded in result.json; do not normalize their line endings on checkout.
automation/results/** -text -eol
automation/returns/** -text -eol
checkpoints/mpp_uni2h_mlp/mpp2_barcode_repair_v003_frozen_baseline_20260711/** -text -eol
checkpoints/mpp_uni2h_mlp/mpp2_lora_r8_dropout10_smoke_20260714_r001/** -text -eol
