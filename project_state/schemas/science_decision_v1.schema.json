{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PFMval science_decision_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "created_at", "experiment_id", "result_binding", "user_confirmation_ref", "decision_summary", "claim", "negative_result", "explanation"],
  "properties": {
    "schema_version": {"const": "science_decision_v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "user_confirmation_ref": {"type": "string", "minLength": 1},
    "result_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "result_id", "acceptance_event_id"],
      "properties": {
        "kind": {"enum": ["single_result", "paired_result", "grouped_result"]},
        "result_id": {"type": "string", "minLength": 1},
        "acceptance_event_id": {"type": "string", "minLength": 1}
      }
    },
    "decision_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "control_value", "treatment_value", "delta", "direction", "stop_rule", "uncertainty", "open_questions"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "control_value": {"type": "number"},
        "treatment_value": {"type": "number"},
        "delta": {"type": "number"},
        "direction": {"type": "string", "minLength": 1},
        "stop_rule": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim": {"type": "object", "required": ["statement"], "properties": {"statement": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "negative_result": {"type": "object", "required": ["route", "outcome", "stop_condition", "continue_condition"], "additionalProperties": true},
    "explanation": {"type": "object", "required": ["observation", "interpretation", "recommendation", "unit", "statistic", "text_description"], "additionalProperties": true}
  }
}
