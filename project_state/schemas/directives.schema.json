{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfmval.local/schemas/directives.schema.json",
  "title": "PFMval directive event",
  "oneOf": [
    {
      "type": "object",
      "required": ["event_type", "directive_id", "issued_at", "summary", "scope", "topic", "status", "source"],
      "properties": {
        "event_type": {"const": "directive"},
        "status": {"enum": ["active", "completed", "superseded", "cancelled"]},
        "source": {"const": "explicit_user_instruction"},
        "supersedes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "effective_from_revision": {"type": "integer", "minimum": 1},
        "affected_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "type": "object",
      "required": ["event_type", "directive_id", "status", "changed_at"],
      "properties": {
        "event_type": {"const": "status_update"},
        "status": {"enum": ["completed", "superseded", "cancelled"]}
      }
    }
  ]
}
