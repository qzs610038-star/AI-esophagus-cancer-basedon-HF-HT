{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfmval.local/schemas/document_registry.schema.json",
  "title": "PFMval document registry",
  "type": "object",
  "required": ["schema_version", "updated_at", "state_revision", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_revision": {"type": "integer", "minimum": 1},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "path", "category", "scope", "authority", "lifecycle", "availability", "verified_at", "state_revision", "content_sha256", "supersedes", "superseded_by", "truth_sources"],
        "properties": {
          "authority": {"enum": ["normative", "derived", "reference"]},
          "lifecycle": {"enum": ["draft", "pending_review", "approved_design", "active", "superseded", "historical", "missing"]},
          "lifecycle_override": {
            "description": "显式人工生命周期覆盖；存在时扫描器优先采用该值而非自动分类，且 authority 固定为 reference",
            "type": ["string", "null"],
            "enum": [null, "draft", "pending_review", "approved_design", "active", "superseded", "historical"]
          },
          "availability": {"enum": ["tracked", "local_only"]},
          "doc_role": {"type": "string", "minLength": 1},
          "related_docs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "dependency_fingerprints": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "freshness": {"enum": ["fresh", "review_due"]},
          "freshness_reason": {"type": "string"},
          "changed_dependencies": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
