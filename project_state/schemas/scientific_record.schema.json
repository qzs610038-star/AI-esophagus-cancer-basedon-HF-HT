{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfmval.local/schemas/scientific_record.schema.json",
  "title": "PFMval local scientific reasoning record",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "created_at",
    "source_refs",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "idea",
        "explore",
        "candidate",
        "claim",
        "negative_result",
        "conflict",
        "explanation"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "experiment_id": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
